{
    "keyboard_name": "rePad",
    "manufacturer": "rrex_keypads",
    "maintainer": "rrex971",
    "url": "https://github.com/rrex971/repad-design",
    "usb": {
        "vid": "0xFEED",
        "pid": "0x0001",
        "device_version": "1.0.0"
    },
    "processor": "RP2040",
    "bootloader": "rp2040",
    "features": {
        "bootmagic": false,
        "extrakey": true,
        "nkro": true,
        "rgb_matrix": true
    },
    "matrix_pins": {
        "direct": [["NO_PIN", "NO_PIN", "NO_PIN"]]
    },
    "diode_direction": "COL2ROW",
    "ws2812": {
        "pin": "GP0",
        "driver": "vendor"
    },
    "rgb_matrix": {
        "driver": "ws2812",
        "max_brightness": 255,
        "animations": {
            "solid_color": true,
            "breathing": true,
            "cycle_all": true,
            "cycle_left_right": true,
            "solid_reactive_simple": true,
            "solid_reactive": true,
            "splash": true
        },
        "layout": [
            {"x": 0, "y": 32, "flags": 4},
            {"x": 112, "y": 32, "flags": 4},
            {"x": 224, "y": 32, "flags": 4}
        ]
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0},
                {"matrix": [0, 1], "x": 1, "y": 0},
                {"matrix": [0, 2], "x": 2, "y": 0}
            ]
        }
    }
}
